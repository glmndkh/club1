# Энэ файлыг .env нэрээр хуулж, утгуудаа бөглөнө:  cp .env.example .env

PORT=8080
# Caddy эсвэл nginx-ийн ард ажиллах үед true
TRUST_PROXY=true
# Gmail шалгах давтамж (минут)
SCAN_MINUTES=5

# (Заавал биш) Gmail-ийг апп-аас биш энд тохируулах бол:
# GMAIL_USER=club@gmail.com
# GMAIL_APP_PASSWORD=abcdabcdabcdabcd

